# Copy to .env (gitignored). Never commit real keys. Never print them in logs.

# Higgsfield (https://open.higgsfield.ai → API keys). Fund ≥ $25 for 10 concurrent jobs. Training opt-out: ON.
HIGGSFIELD_KEY_ID=
HIGGSFIELD_KEY_SECRET=
HIGGSFIELD_WEBHOOK_SECRET=

# ElevenLabs (Creator plan for commercial rights + 192 kbps)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID_DEFAULT=

# Free-tier LLM keys — the ONLY LLM providers allowed. Model ids live in config/llm.yaml.
GEMINI_API_KEY=
GEMINI_API_KEY_JUDGE=          # optional second key so QC never starves behind planning
GROQ_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=

# Local services (docker compose)
DATABASE_URL=postgresql://studio:studio@localhost:5432/studio
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=assets
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123

# App
NEXT_PUBLIC_API_URL=http://localhost:4000
HOSTING_PHASE_UNLOCKED=false   # flips to true only after G3 is recorded in PROGRESS.md
