# Copy to .env (gitignored). Never commit real keys. Never print them in logs.
# This template must never hold a secret value (a test in workers/tests/test_config.py enforces it).

# Higgsfield (https://open.higgsfield.ai → API keys). Fund ≥ $25 for 10 concurrent jobs. Training opt-out: ON.
HIGGSFIELD_KEY_ID=
HIGGSFIELD_KEY_SECRET=
HIGGSFIELD_WEBHOOK_SECRET=

# ElevenLabs (Creator plan for commercial rights + 192 kbps)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID_DEFAULT=

# Free-tier LLM keys — the ONLY LLM providers allowed. Model ids live in config/llm.yaml.
GEMINI_API_KEY=
# Optional second Gemini key so QC never starves behind planning.
GEMINI_API_KEY_JUDGE=
GROQ_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=

# Phase 0: plain files only, no containers (owner decision 4 Nov 2026). Relative paths resolve against the repo
# root. These values equal the code defaults, so they may be left out of .env.
ASSETS_DIR=./assets
STEP_CACHE_PATH=./.cache/steps.sqlite3
PROOFS_OUT_DIR=./proofs/out
# ffmpeg with libass, freetype and harfbuzz (Devanagari captions). Owner decision 6 Nov 2026: the signed
# martin-riedl.de 9.0.2 macOS arm64 release, kept outside the repo. ffprobe is taken from the same folder.
# Check it with: uv run python -m engine.ffmpeg
FFMPEG_BIN=~/tools/ffmpeg/ffmpeg

# Phase 1.1 (docker compose: postgres, redis, minio; local only). Not used in Phase 0.
# DATABASE_URL=postgresql://localhost:5432/studio   (1.1 sets the user and password in .env only)
# REDIS_URL=redis://localhost:6379/0
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=assets
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# App
NEXT_PUBLIC_API_URL=http://localhost:4000
# Flips to true only after G3 is recorded in PROGRESS.md.
HOSTING_PHASE_UNLOCKED=false
